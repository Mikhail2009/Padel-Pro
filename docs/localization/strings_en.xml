    <string name="course_1_title">Padel Fundamentals</string>
    <string name="course_1_desc">Learn the core concept of padel, the glass walls, basic scoring flow, and how a rally is played.</string>
    <string name="course_2_title">Court and Equipment</string>
    <string name="course_2_desc">Understand court dimensions, the net, glass and mesh walls, rackets, and official padel balls.</string>
    <string name="course_3_title">Rules and Scoring</string>
    <string name="course_3_desc">Master the tennis-style count, deuce modes, tie-breaks, and how sets decide a padel match.</string>
    <string name="course_4_title">Serving</string>
    <string name="course_4_desc">Underarm serve mechanics, diagonal service boxes, foot faults, lets, and serving rotation.</string>
    <string name="course_5_title">Techniques</string>
    <string name="course_5_desc">Core strokes including forehand, backhand, bandeja, vibora, volley, lob, and bajada.</string>
    <string name="course_6_title">Court Positioning</string>
    <string name="course_6_desc">Moving as a pair between defense at the back glass and attacking pressure at the net.</string>
    <string name="course_7_title">Doubles Strategy</string>
    <string name="course_7_desc">Coordinated communication, covering the middle, lobs to regain the net, and target selection.</string>
    <string name="course_8_title">Advanced Tactics</string>
    <string name="course_8_desc">Controlling match tempo, playing off double glass, chiquitas, and handling deciding points.</string>

